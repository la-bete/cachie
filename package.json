{
	"name": "cachie",
	"version": "0.0.0",
	"description": "Search-token analytics over an in-memory TTL cache, with exact and fuzzy matching and an OpenAPI-validated REST API",
	"main": "src/app.js",
	"scripts": {
		"start": "node src/app.js",
		"dev": "nodemon src/app.js",
		"test": "jest",
		"lint": "eslint --fix .",
		"prepare": "husky install"
	},
	"keywords": [],
	"author": "labete",
	"license": "MIT",
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.18.2",
		"express-openapi-validator": "^5.4.2",
		"express-rate-limit": "^7.5.0",
		"pino": "^9.6.0"
	},
	"devDependencies": {
		"eslint": "^8.54.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"husky": "^8.0.0",
		"jest": "^29.7.0",
		"nodemon": "^3.0.1",
		"pino-pretty": "^13.0.0",
		"prettier": "^3.4.2",
		"supertest": "^6.3.3"
	},
	"jest": {
		"testEnvironment": "node",
		"coverageDirectory": "coverage",
		"collectCoverageFrom": [
			"src/**/*.js"
		]
	},
	"eslintConfig": {
		"env": {
			"es2021": true,
			"node": true,
			"jest": true
		},
		"extends": [
			"eslint:recommended",
			"plugin:prettier/recommended"
		],
		"parserOptions": {
			"ecmaVersion": 12,
			"sourceType": "module"
		},
		"rules": {}
	},
	"husky": {
		"hooks": {
			"pre-commit": "npm test && npm run lint"
		}
	}
}
